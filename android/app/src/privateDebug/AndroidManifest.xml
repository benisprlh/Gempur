<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Private, consenting-adult trial only. Ordinary variants do not merge this manifest. -->
    <!-- Query only launchable apps for local name analysis; do not request a full app inventory. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
    <application android:label="Gempur Privat" android:networkSecurityConfig="@xml/network_security_debug"
        tools:replace="android:label,android:networkSecurityConfig">
        <service android:name=".PrivateAutomationService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started private consenting-adult detection sharing and companion polling with a visible notification"/>
        </service>
        <service android:name=".PrivateAppGuardService" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/private_app_guard"/>
        </service>
    </application>
</manifest>
